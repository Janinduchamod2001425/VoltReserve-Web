## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.
## See https://github.com/dotnet/dotnet/blob/main/.gitignore for reference

# Build Folders
bin/
obj/

# Visual Studio
.vs/
*.user
*.suo
*.userosscache
*.sln.docstates

# Rider
.idea/

# Visual Studio Code
.vscode/

# NuGet
*.nupkg
# The packages folder can be ignored because of Package Restore
**/packages/*
!**/packages/build/**

# Azure Pipelines
.azure-pipelines/

# DotNet CLI
project.lock.json
project.fragment.lock.json
artifacts/

# Publish outputs
publish/

# Logs
*.log

# User-specific files
*.rsuser
*.suo
*.user
*.userprefs

# OS generated files
.DS_Store
Thumbs.db

# User secrets (if used via Secret Manager)
secrets.json

# Local appsettings
appsettings.Development.json

# Coverage & test results
TestResults/
.coverage
.coveragexml

# Entity Framework
*.db

# Others
*.vsix
