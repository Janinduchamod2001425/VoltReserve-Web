{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "MongoDbSettings": {
    "ConnectionString": "${MONGO_CONNECTION_STRING}",
    "DatabaseName": "EVChargingDB"
  },

  "Jwt": {
    "Key": "${JWT_KEY}",
    "Issuer": "EVChargingAPI",
    "Audience": "EVChargingClients",
    "ExpiryMinutes": 60
  },

  "Smtp": {
    "Host": "smtp.gmail.com",
    "Port": 587,
    "UseStartTls": true,
    "User": "${SMTP_USER}",
    "Pass": "${SMTP_PASS}",
    "FromName": "VoltReserve",
    "FromEmail": "${SMTP_FROM}"
  },

  "GoogleMaps": {
    "ApiKey": "${GOOGLE_MAPS_API_KEY}"
  }
}
